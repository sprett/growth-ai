# Copy to .env.local (or .env) and fill in. Never commit real keys.

# --- LLM (needed for parse / diff / next-hypothesis) ---
# Pick one provider and fill that key. Leave the other blank.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# --- GitHub (open PRs + merge webhook) ---
# Fine-grained PAT on this repo with Contents + Pull requests write is enough for hour 1.
# GitHub App (from relay) can replace this later if we have time.
GITHUB_TOKEN=
GITHUB_REPO_OWNER=sprett
GITHUB_REPO_NAME=growth-ai
GITHUB_WEBHOOK_SECRET=

# --- PostHog ---
POSTHOG_API_KEY=
POSTHOG_PROJECT_ID=
POSTHOG_HOST=https://us.i.posthog.com

# --- Supabase ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
