# Copy to .env (or .env.local). Never commit real keys.

# --- This product (operator + pipeline) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# LLM for parse / diff / next-hypothesis
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# GitHub App for *this* product (installs onto the customer repo)
# Setup URL in the GitHub App settings: http://localhost:3000/onboarding
# (GitHub sends installation_id back there after Install GitHub App)
# Slug only, not the full URL — e.g. hackathon-agentic-app
NEXT_PUBLIC_GITHUB_APP_SLUG=
GITHUB_APP_ID=
GITHUB_APP_PRIVATE_KEY=
GITHUB_WEBHOOK_SECRET=

# Optional: our own product analytics, not the customer's
NEXT_PUBLIC_POSTHOG_PROJECT_TOKEN=
NEXT_PUBLIC_POSTHOG_HOST=https://eu.i.posthog.com

# --- Seeded into connections (fake-customer tenant). Not read by pipeline code. ---
DEMO_GITHUB_REPO_FULL_NAME=sprett/foldline
DEMO_GITHUB_INSTALLATION_ID=
DEMO_POSTHOG_API_KEY=
DEMO_POSTHOG_PROJECT_ID=
DEMO_POSTHOG_HOST=https://eu.i.posthog.com
